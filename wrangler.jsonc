{
  "name": "devarity-web",
  "main": "./worker.js",
  "compatibility_date": "2026-09-18",
  "workers_dev": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Check the hostname before serving any asset, including HTML navigation.
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  }
}
